# ==============================================================================
# AgentOne Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="AgentOne Autonomous Operations Engine"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Primary LLM Provider: "mock" (default for zero-key test), "gemini", "openai", "anthropic"
DEFAULT_LLM_PROVIDER="mock"

# Model Identifiers
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_MODEL="gpt-4o"
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# API Keys (Provide any or leave empty for mock provider)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Multi-Agent Parameters
MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.2

# Safety & Guardrail Settings
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_SHIELD=true
ENABLE_OUTPUT_VERIFIER=true
INJECTION_RISK_THRESHOLD=0.65

# RAG & Knowledge Engine
RAG_TOP_K=4
RAG_HYBRID_ALPHA=0.5
RAG_EMBEDDING_DIM=384
KNOWLEDGE_STORE_PATH="data/knowledge_base"

# Human-In-The-Loop Thresholds
HITL_AUTO_PAUSE_ACTIONS="refund_process,delete_user,update_rbac,database_schema_migration"
HITL_REFUND_THRESHOLD_USD=500.00
